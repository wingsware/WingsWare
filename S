local function iniciarSpam()
    -- SISTEMA 1
    if next(revertedRemotes) then
        CONEXAO_SPAM1 = RunService.Stepped:Connect(function()
            if manualSpamActive then
                for _ = 1, math.random(6, 9) do 
                    for remoteSpam, args in pairs(revertedRemotes) do
                        pcall(function() remoteSpam:FireServer(unpack(args)) end)
                    end
                end
            end
        end)
    end

    -- SISTEMA 2 COM ANIMAÇÃO
    CONEXAO_SPAM2 = RunService.Heartbeat:Connect(function(dt)
        if dt > 0 then fps = 1 / dt end
        if Enabled and remote and f_raw then
            timeAccumulator += dt
            local packetsToFire = math.floor(timeAccumulator * targetCPS)
            if packetsToFire > 0 then
                timeAccumulator -= (packetsToFire / targetCPS)
                for i = 1, packetsToFire do
                    task.spawn(function() pcall(f_raw, remote, unpack(c)) end)
                    serverFireCounter += 1
                end
                SpamParry_Animation() -- ANIMAÇÃO CHAMADA AQUI
            end
        else 
            timeAccumulator = 0 
        end
    end)

    -- STATUS
    CONEXAO_STATUS = task.spawn(function()
        while wingsSpamAtivo do
            local ping = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() or 0
            local currentCPS = math.floor((serverFireCounter - lastServerFire) / 0.2)
            lastServerFire = serverFireCounter
            task.wait(0.2)
        end
    end)
end

local function pararSpam()
    if CONEXAO_SPAM1 then
        CONEXAO_SPAM1:Disconnect()
        CONEXAO_SPAM1 = nil
    end
    if CONEXAO_SPAM2 then
        CONEXAO_SPAM2:Disconnect()
        CONEXAO_SPAM2 = nil
    end
    if CONEXAO_STATUS then
        task.cancel(CONEXAO_STATUS)
        CONEXAO_STATUS = nil
    end
end

