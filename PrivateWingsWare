local function PegarDadosJogador(jogador)
    local ping = 0
    pcall(function()
        if jogador:FindFirstChild("NetworkStats") and jogador.NetworkStats:FindFirstChild("Ping") then
            ping = math.floor(jogador.NetworkStats.Ping.Value + 0.5)
        else
            ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() * (0.9 + math.random() * 0.3) + 0.5)
        end
    end)

    local fps = 0
    pcall(function()
        if jogador.Character and jogador.Character.PrimaryPart then
            fps = math.clamp(math.floor(60 * (1 - (ping / 350)) + 0.5), 15, 60)
        end
    end)

    ping = ping > 0 and ping or 20
    fps = fps > 0 and fps or 30

    return fps, ping
end

local function CriarEtiqueta(jogador)
    if etiquetasJogadores[jogador] then return end

    local etiqueta = Instance.new("BillboardGui")
    etiqueta.Name = "InfoJogador"
    etiqueta.AlwaysOnTop = true
    etiqueta.Size = UDim2.new(0, 140, 0, 45)
    etiqueta.MaxDistance = 120
    etiqueta.LightInfluence = 0

    local texto = Instance.new("TextLabel", etiqueta)
    texto.Size = UDim2.new(1,0,1,0)
    texto.BackgroundTransparency = 1
    texto.TextColor3 = INFO_COLOR
    texto.Font = Enum.Font.GothamMedium
    texto.TextScaled = true
    texto.Text = jogador.Name .. "\nCarregando..."

    local conexao = RunService.Heartbeat:Connect(function()
        if not mostrarInfoJogadores or not jogador.Character or not jogador.Character.PrimaryPart then
            etiqueta.Enabled = false
            return
        end
        
        etiqueta.Enabled = true
        etiqueta.Adornee = jogador.Character.PrimaryPart

        local fps, ping = PegarDadosJogador(jogador)
        texto.Text = string.format("%s\nFPS: %d | MS: %d", jogador.Name, fps, ping)
    end)

    etiquetasJogadores[jogador] = {Gui = etiqueta, Conexao = conexao}
    etiqueta.Parent = Player.PlayerGui
end

