local function setupCapture()
	local mt = getrawmetatable(game)
	local old = mt.__index
	setreadonly(mt, false)

	mt.__index = newcclosure(function(self, key)
		if key == "FireServer" or key == "InvokeServer" then
			return function(instance, ...)
				local a = {...}
				if #a == 7 and typeof(a[4]) == "CFrame" then
					remote = self
					f_raw = old(instance, "FireServer")
					original_args = a
					for i = 1, 7 do
						c[i] = a[i]
					end
				end
				return old(self, key)(self, ...)
			end
		end
		return old(self, key)
	end)

	setreadonly(mt, true)
end

-- =========================================
-- HOOKS
-- =========================================

local function isValidRemoteArgs(args)
	return #args == 7 and typeof(args[4]) == "CFrame"
end

local function hookRemote(remote)
	local meta = getrawmetatable(remote)
	if not meta then return end
	setreadonly(meta, false)

	local oldIndex = meta.__index
	meta.__index = function(self, key)
		if key == "FireServer" and self:IsA("RemoteEvent") then
			return function(_, ...)
				local args = {...}
				if isValidRemoteArgs(args) or self.Name:find("Parry") then
					revertedRemotes[self] = args
				end
				return oldIndex(self, "FireServer")(_, unpack(args))
			end
		end
		return oldIndex(self, key)
	end

	setreadonly(meta, true)
end

