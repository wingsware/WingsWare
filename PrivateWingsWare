		atualizarPosicoes(input.Position - dragStart)
	end
end)

-- =========================================
-- SISTEMA DE SPAM SEM AUMENTAR PING
-- =========================================

local function iniciarSpam()
	CONEXAO_SPAM1 = RunService.Heartbeat:Connect(function(dt)
		if wingsSpamAtivo and remote and f_raw then
            
            local cpsUsado = modos[modoAtual].cps

            local pingAtual = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() or 50
            local limitePorFrame = math.clamp(math.floor(cpsUsado / 60), 2, 10) 

            if pingAtual > 140 then cpsUsado = cpsUsado * 0.8 end
            if pingAtual > 180 then cpsUsado = cpsUsado * 0.6 end

			spamAccum = spamAccum + dt * cpsUsado
			local fires = math.floor(spamAccum)

			if fires > 0 then
                fires = math.min(fires, limitePorFrame)
				spamAccum = spamAccum - fires
				local modified_args = getModifiedArgs()
				for _ = 1, fires do
					pcall(function()
						if remote:IsA('RemoteEvent') then
							f_raw(remote, unpack(modified_args))
						elseif remote:IsA('RemoteFunction') then
							remote:InvokeServer(unpack(modified_args))
						end
					end)
				end
			end
			SpamParry_Animation()
		else
			spamAccum = 0
		end
	end)
end

local function pararSpam()
	if CONEXAO_SPAM1 then
		CONEXAO_SPAM1:Disconnect()
		CONEXAO_SPAM1 = nil
	end
	timeAccumulator = 0
	local humanoid = GetHumanoid()
	if humanoid and Grab_Parry then
		Grab_Parry:Stop(0.1)
	end
end

local function atualizarEstadoBotao()
	if wingsSpamAtivo then
